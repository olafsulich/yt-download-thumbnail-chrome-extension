{
  "manifest_version": 3,
  "name": "YouTube Thumbnail Downloader",
  "short_name": "YT Thumbnail",
  "version": "1.0.0",
  "description": "Adds a clean one-click button to download the highest-quality thumbnail of any YouTube video.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads"],
  "host_permissions": ["https://i.ytimg.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
